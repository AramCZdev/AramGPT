{
  "name": "aramgpt-cf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "node --check src/worker.js && node --check src/gateway.js",
    "deploy": "wrangler deploy",
    "register:commands": "node scripts/register-commands.mjs",
    "secret:token": "wrangler secret put DISCORD_TOKEN",
    "secret:openrouter": "wrangler secret put OPENROUTER_API_KEY"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "wrangler": "^3.91.0"
  }
}